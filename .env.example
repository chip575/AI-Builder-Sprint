# 남기다 — 환경변수 양식. 실제 값은 .env에 (커밋 차단됨, 보안 6조).
# 전부 비워도 mock 모드로 전 흐름이 돈다 (NFR-707 — 예선 채점 경로).
# 각 키의 발급 위치·채운 직후 할 일은 .env(로컬 양식)와 docs/handoff-2026-07-29.md §D 4.6 참조.

# ── Supabase (Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstage (console.upstage.ai → API Keys · 쿠폰: Billing→Credit→Redeem) ──
# ⚠ 크레딧 소진 후에도 과금 계속 — 키 등록 시점부터 Usage 하루 2회 확인 (02.5 §5)
UPSTAGE_API_KEY=
UPSTAGE_MODE=mock

# ── 모두싸인 (설정 → API · 웹훅: 워크스페이스 설정 → Webhook) ──
MODUSIGN_API_KEY=
MODUSIGN_MODE=mock
MODUSIGN_WEBHOOK_SECRET=

# 템플릿 8종 — PM이 콘솔에서 서식 생성 후 ID 기입 (D-12 임계경로)
MODUSIGN_TEMPLATE_DONATION_PLEDGE=
MODUSIGN_TEMPLATE_RECURRING_CONSENT=
MODUSIGN_TEMPLATE_PRIVACY_CONSENT=
MODUSIGN_TEMPLATE_LEGACY_GIFT=
MODUSIGN_TEMPLATE_HERITAGE_PLEDGE=
MODUSIGN_TEMPLATE_ATTESTATION=
MODUSIGN_TEMPLATE_FAMILY_ACK=
MODUSIGN_TEMPLATE_CUSTODIAN=
# 철회 통지서 (민법 §1108① · 사인증여 철회). 없으면 철회는 되지만 기관 통지가 실패한다
MODUSIGN_TEMPLATE_REVOCATION_NOTICE=

# ── 기타 (선택) ──
# 증빙 만료 URL 서명 키 — mock 전용. Storage signed URL 전환 시 제거 (app/api/evidence/sign-url.ts)
# Vercel cron 인증 토큰 — 없으면 스케줄러가 돌아도 리컨실러가 실행되지 않는다.
# 값은 직접 만든다: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

EVIDENCE_URL_SECRET=

# ── e2e 관통 검사 (선택) ──
# 인증이 켜진 환경(Supabase 키 있음)에서는 비로그인에 신원이 없어 첫 요청부터 401이다.
# scripts/e2e-mock.mjs가 이 값으로 먼저 로그인한다. 키 없는 채점 경로에서는 불필요하다.
# 값은 가상 데모 계정만 쓴다 (보안 4조).
E2E_EMAIL=
E2E_PASSWORD=
